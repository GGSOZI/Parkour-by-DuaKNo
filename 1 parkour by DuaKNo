if TILT_ENABLED then
	local tilt = 0
	RunService:BindToRenderStep("CustomAnimTilt", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local cam = workspace.CurrentCamera
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		if not (cam and root) then return end
		local lateral = root.AssemblyLinearVelocity:Dot(cam.CFrame.RightVector)
		local k = Hud.mode == "swing" and TILT_SWING_MULT or 1
		local target = math.clamp(lateral / 45, -1, 1) * TILT_MAX * k
		tilt = tilt + (target - tilt) * (1 - math.exp(-7 * dt))
		cam.CFrame = cam.CFrame * CFrame.Angles(0, 0, -tilt)
	end)
end

