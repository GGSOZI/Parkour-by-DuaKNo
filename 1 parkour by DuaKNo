local Haptic = {}
local HAPTIC = {
	dash = {"Large", 0.5, 0.12}, flip = {"Small", 0.5, 0.08}, land = {"Large", 0.6, 0.1},
	roll = {"Large", 0.7, 0.15}, slide = {"Small", 0.6, 0.12}, grab = {"Small", 0.8, 0.1},
	release = {"Small", 0.4, 0.06}, wallStick = {"Small", 0.5, 0.06}, wallJump = {"Small", 0.6, 0.08},
}
function Haptic.supported()
	local ok, res = pcall(function()
		local pad = Enum.UserInputType.Gamepad1
		return HapticService:IsVibrationSupported(pad) and HapticService:IsMotorSupported(pad, Enum.VibrationMotor.Small)
	end)
	return ok and res == true
end
function Haptic.buzz(motorName, strength, dur)
	if not Store.data.vibration then return end
	task.spawn(function()
		pcall(function()
			local pad = Enum.UserInputType.Gamepad1
			if not HapticService:IsVibrationSupported(pad) then return end
			local motor = Enum.VibrationMotor[motorName]
			if not HapticService:IsMotorSupported(pad, motor) then return end
			HapticService:SetMotor(pad, motor, strength)
			task.wait(dur)
			HapticService:SetMotor(pad, motor, 0)
		end)
	end)
end
function Haptic.event(name)
	local h = HAPTIC[name]
	if h then Haptic.buzz(h[1], h[2], h[3]) end
end

