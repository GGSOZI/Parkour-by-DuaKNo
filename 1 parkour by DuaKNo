	local function updateTier(p)
		for _ = 1, 2 do
			if tier == 1 then
				if p > WALK_MAX_PCT + HYSTERESIS then tier = 2 end
			elseif tier == 2 then
				if p < WALK_MAX_PCT - HYSTERESIS then
					tier = 1
				elseif p > MEDIUM_MAX_PCT + HYSTERESIS then
					tier = 3
				end
