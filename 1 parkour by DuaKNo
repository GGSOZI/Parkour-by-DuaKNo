			if (page + 1) * SLOTS < #items then
				page += 1
				render()
				if not finished and (page + 2) * SLOTS > #items then fetchMore() end
			elseif not finished then
				pendingNext = true
				if loading then render() else fetchMore() render() end
			end
		end)
		search.FocusLost:Connect(function(enter)
			if enter and search.Text ~= keyword then
				resetSearch(search.Text)
			end
		end)
		for i = 1, SLOTS do
			local b = slots[i].btn
			b.MouseEnter:Connect(function()
				if items[page * SLOTS + i] then setHover(i) end
			end)
			b.MouseLeave:Connect(function()
				if hoverIndex == i then setHover(nil) end
			end)
			b.InputBegan:Connect(function(inp)
				if inp.UserInputType == Enum.UserInputType.Touch and items[page * SLOTS + i] then
					setHover(i)
				end
			end)
			b.Activated:Connect(function()
				local item = items[page * SLOTS + i]
				if not item then return end
				if pickKey then
					local key = pickKey
					pickKey = nil
					Anim.set(key, item.id, item.name)
					setTab("custom")
				else
					Emote.pending = item.id
					setOpen(false)
				end
			end)
		end

		UserInputService.InputBegan:Connect(function(i, gp)
			if gp then return end
			if i.KeyCode == KEY_EMOTES then
				setOpen(not panel.Visible)
			end
		end)

		local cam = workspace.CurrentCamera
		if cam then
			table.insert(Session.conns, cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
				if panel.Visible then layout() end
			end))
		end

		styleTab(tabEmotes, true)
		styleTab(tabCustom, false)
		refreshCustom()
		Hooks.openCustomize = function()
			setOpen(true)
			pickKey = nil
			setTab("custom")
		end
	end)
end

