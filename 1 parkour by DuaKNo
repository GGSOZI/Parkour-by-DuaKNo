local function getAnimation(id)
	local assetId = "rbxassetid://" .. tostring(id)
	local list = {}

	local direct = Instance.new("Animation")
	direct.AnimationId = assetId
	table.insert(list, direct)

	local ok, objs = pcall(function()
		return game:GetObjects(assetId)
	end)
	if ok and objs and objs[1] then
		local obj = objs[1]
		local found = obj:IsA("Animation") and obj or obj:FindFirstChildWhichIsA("Animation", true)
		if found and found.AnimationId ~= "" and found.AnimationId ~= assetId then
			table.insert(list, found)
		end
	end
	return list
end

