local function trackedService(svc)
	local cache = {}
	return setmetatable({}, {
		__index = function(_, k)
			local v = svc[k]
			if typeof(v) == "RBXScriptSignal" then
				local p = cache[k]
				if not p then
					p = {
						Connect = function(_, f)
							local c = v:Connect(f)
							table.insert(Session.conns, c)
							return c
						end,
						Once = function(_, f)
							local c = v:Once(f)
							table.insert(Session.conns, c)
							return c
						end,
						Wait = function(_)
							return v:Wait()
						end,
					}
					cache[k] = p
				end
				return p
			elseif type(v) == "function" then
				return function(_, ...)
					return v(svc, ...)
				end
			end
			return v
		end,
		__newindex = function(_, k, val)
			svc[k] = val
		end,
	})
end

