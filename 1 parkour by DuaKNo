local B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local function decodeBase64(data)
	data = (data:gsub("%s+", ""))
	local lookup = {}
	for i = 1, 64 do
		lookup[string.byte(B64_CHARS, i)] = i - 1
	end
	local pad = 0
	if data:sub(-2) == "==" then pad = 2 elseif data:sub(-1) == "=" then pad = 1 end
	local out, n = {}, 0
	for i = 1, #data, 4 do
		local a, b, c, d = string.byte(data, i, i + 3)
		local v = lookup[a] * 262144 + lookup[b] * 4096 + (lookup[c] or 0) * 64 + (lookup[d] or 0)
		n += 1
		out[n] = string.char(v // 65536, (v // 256) % 256, v % 256)
		if n % 12000 == 0 then task.wait() end
	end
	local s = table.concat(out)
	if pad > 0 then s = s:sub(1, #s - pad) end
	return s
end

local function playIntroAudio()
	if not AUDIO_ENABLED then return end
	local SoundService = game:GetService("SoundService")
	local oldSound = SoundService:FindFirstChild("CustomAnimIntroSound")
	if oldSound then oldSound:Destroy() end

	local soundId
	if AUDIO_ASSET_ID ~= 0 then
		soundId = "rbxassetid://" .. tostring(AUDIO_ASSET_ID)
	else
		local ok, res = pcall(function()
			local write, exists, asset = writefile, isfile, (getcustomasset or getsynasset)
			if not (write and asset) then
				error("this executor has no writefile / getcustomasset")
			end
			if not (exists and exists(AUDIO_FILE_NAME)) then
				write(AUDIO_FILE_NAME, decodeBase64(AUDIO_B64))
			end
			return asset(AUDIO_FILE_NAME)
		end)
		if not ok then
			warn("[CustomAnims] Intro audio not played: " .. tostring(res) .. " (set AUDIO_ASSET_ID instead)")
			return
		end
		soundId = res
	end

	local sound = Instance.new("Sound")
	sound.Name = "CustomAnimIntroSound"
	sound.SoundId = soundId
	sound.Volume = AUDIO_VOLUME
	sound.Looped = false
	sound.Parent = SoundService
	sound.Ended:Connect(function()
		sound:Destroy()
	end)
	sound:Play()
end

task.spawn(playIntroAudio)

if player.Character then
	task.spawn(bindCharacter, player.Character)
end
Session.conns[#Session.conns + 1] = player.CharacterAdded:Connect(function(char)
	task.spawn(bindCharacter, char)
end)
