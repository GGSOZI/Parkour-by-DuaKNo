	local function updateClimb(now)
		local dir = -wallN
		local res = wallHit(root.Position, dir, CLIMB_REACH + 0.5)

		local move = hum.MoveDirection
		local vIn = move:Dot(dir)
		local hIn = move:Dot(dir:Cross(Vector3.yAxis))
		local vy = 0
		if math.abs(vIn) > CLIMB_DEADZONE then
			vy = math.clamp(vIn * 1.5, -1, 1) * CLIMB_SPEED
		end

		if not res then

			local up = lastVy > 0
			endClimb()
			climbLockUntil = now + 0.35
			if up then
				root.AssemblyLinearVelocity = dir * MANTLE_FORWARD + Vector3.new(0, MANTLE_UP, 0)
			end
			return
		end

		wallN = Vector3.new(res.Normal.X, 0, res.Normal.Z).Unit
		dir = -wallN
		local err = (res.Position - root.Position):Dot(dir) - CLIMB_DIST
		lv.VectorVelocity = Vector3.new(0, vy, 0) + dir * math.clamp(err * 12, -10, 10)
		ao.CFrame = CFrame.lookAt(root.Position, root.Position + dir)

		if vy < 0 then
			local g = workspace:Raycast(root.Position, Vector3.new(0, -3.6, 0), rayParams)
			if g then
				endClimb()
				climbLockUntil = now + 0.4
				return
			end
		end

		climbSideways = math.abs(hIn) > 0.5 and math.abs(vIn) < 0.5
		climbHIn = hIn
		placeWallFx(dir)
		wallDust.Enabled = vy ~= 0
		lastVy = vy

		local entry = climbTracks[climbIndex]
		if entry and usable(entry) then
			local track = best(entry)
			setTrack(track)
			track:AdjustSpeed(vy ~= 0 and 1 or 0)
		else
			setTrack(nil)
		end
	end

	local function doWallJump(now)
		placeWallFx(-wallN)
		wallDust:Emit(50)
		shockwave(root.Position + (-wallN) * 1.2, wallN, Color3.fromRGB(255, 220, 120), 16, 0.5)
		shake(0.3)
		fovKick = math.max(fovKick, 10)
		local right = (-wallN):Cross(Vector3.yAxis)
		local launch
		if climbSideways then
			local s = climbHIn > 0 and 1 or -1
			launch = wallN * WALLJUMP_OUT + right * s * WALLJUMP_SIDE + Vector3.new(0, WALLJUMP_UP, 0)
		else
			launch = wallN * (WALLJUMP_OUT + 4) + Vector3.new(0, WALLJUMP_UP * 0.9, 0)
		end
		endClimb()
		climbLockUntil = now + 0.35
		local flat = Vector3.new(launch.X, 0, launch.Z)
		root.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
		root.AssemblyLinearVelocity = launch
		jumpActive = true
		fallMode = false
		jumpGrace = now + 0.25
		jumpIndex = pickRandom(jumpTracks, jumpIndex)
	end

	local wallWalking = false
	local wwN = Vector3.zAxis
	local wwLook = Vector3.yAxis
	local wwSpeedNow = 0
	local wwStill = 0

	local function projectOnSurface(v, n)
		return v - n * v:Dot(n)
	end

	local function surfaceHit(origin, dir, dist)
		local res = workspace:Raycast(origin, dir * dist, rayParams)
		if res and not isCharacterPart(res.Instance) then
			return res
		end
		return nil
	end

	local function wwCFrame()
		return CFrame.fromMatrix(Vector3.zero, wwLook:Cross(wwN), wwN, -wwLook)
	end

	local function startWallWalk(normal)
		wallWalking = true
		wwN = normal.Unit
		local up = projectOnSurface(Vector3.yAxis, wwN)
		if up.Magnitude > 0.1 then
			wwLook = up.Unit
		else
			wwLook = projectOnSurface(root.CFrame.LookVector, wwN).Unit
		end
		wwSpeedNow = 0
		wwStill = 0
		WW.run = false
		WW.lost = 0
		WW.lastRes = nil
		hum.PlatformStand = true
		hum.AutoRotate = false
		root.AssemblyLinearVelocity = Vector3.zero
		lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
		lv.VectorVelocity = Vector3.zero
		lv.Enabled = true
		ao.CFrame = wwCFrame()
		ao.Enabled = true
		fallMin = 0
		jumpActive = false
		wallAttach.WorldPosition = root.Position - wwN * (WW_DIST - 0.2)
		wallAttach.WorldAxis = wwN
		wallDust:Emit(10)
		trick("WALL", "wallStick")
		shake(0.08)
	end

	local function endWallWalk(now)
		wallWalking = false
		local wasRun = WW.run
		WW.run = false
		Hang.active = nil
		wallDust.Enabled = false
		lv.Enabled = false
		ao.Enabled = false
		local face = Vector3.new(wwLook.X, 0, wwLook.Z)
		if face.Magnitude < 0.4 then
			face = Vector3.new(-wwN.X, 0, -wwN.Z)
		end
		if face.Magnitude < 0.1 then
			face = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		end
		if face.Magnitude < 0.1 then face = Vector3.zAxis end
		face = face.Unit
		local pos = root.Position + Vector3.new(0, 1, 0)
		root.CFrame = CFrame.lookAt(pos, pos + face)
		root.AssemblyLinearVelocity = wasRun and (WW.runDir * math.min(wwSpeedNow, WALLRUN_SPEED) * 0.9 + Vector3.new(0, 4, 0)) or Vector3.zero
		hum.PlatformStand = false
		hum.AutoRotate = true
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
		climbLockUntil = now + 0.35
		wasMoving = true
		smoothSpeed = 10
		tier = 2
	end

	function WW.find(pos, dir, surfUp, rightV)
		local reach = WW_DIST + 2.5
		local r = surfaceHit(pos, dir, reach)
		if r then return r end
		local offs = {surfUp * 1.6, -surfUp * 1.6, rightV * 1.6, -rightV * 1.6}
		for _, o in ipairs(offs) do
			r = surfaceHit(pos + o, dir, reach + 1)
			if r and r.Normal:Dot(wwN) > 0.5 then return r end
		end
		return nil
	end

	function WW.start(res, fd, side, spd, now)
		startWallWalk(res.Normal)
		local hn = Vector3.new(wwN.X, 0, wwN.Z)
		hn = hn.Magnitude > 0.1 and hn.Unit or Vector3.new(-fd.Z, 0, fd.X)
		local run = fd - hn * fd:Dot(hn)
		run = run.Magnitude > 0.1 and run.Unit or fd
		WW.run = true
		WW.runUntil = now + WALLRUN_TIME
		WW.runDir = run
		WW.side = side
		WW.lastRes = res
		wwLook = run
		wwSpeedNow = math.clamp(spd, WALLRUN_MIN_SPEED, WALLRUN_SPEED)
		lv.VectorVelocity = run * wwSpeedNow
		trick("WALL RUN", "wallStick")
	end

	function WW.updateRun(now, dt)
		fallMin = 0
		Hang.active = nil
		local pos = root.Position
		local dir = -wwN
		local run = WW.runDir

		if now >= WW.runUntil then
			endWallWalk(now)
			return
		end

		local move = hum.MoveDirection
		if move.Magnitude > 0.1 then
			local hn = Vector3.new(wwN.X, 0, wwN.Z)
			if (hn.Magnitude > 0.1 and move:Dot(hn.Unit) > 0.75) or move:Dot(run) < -0.6 then
				endWallWalk(now)
				return
			end
		end

		local res = surfaceHit(pos, dir, WALLRUN_REACH + 2.5)
		if res and math.abs(res.Normal.Y) > 0.6 then res = nil end
		if res then
			WW.lost = 0
			WW.lastRes = res
			local hn2 = Vector3.new(res.Normal.X, 0, res.Normal.Z)
			if hn2.Magnitude > 0.1 then
				wwN = wwN:Lerp(hn2.Unit, 0.3).Unit
				local hn = Vector3.new(wwN.X, 0, wwN.Z)
				if hn.Magnitude > 0.1 then
					hn = hn.Unit
					local r = run - hn * run:Dot(hn)
					if r.Magnitude > 0.2 then
						run = r.Unit
						WW.runDir = run
						wwLook = run
					end
				end
			end
		else
			WW.lost += dt
			if WW.lost > 0.2 or not WW.lastRes then
				endWallWalk(now)
				return
			end
			res = WW.lastRes
		end

		local ahead = surfaceHit(pos, run, 4.5)
		if ahead and math.abs(ahead.Normal.Y) < 0.5 and ahead.Normal:Dot(run) < -0.5 then
			WW.run = false
			wwN = ahead.Normal.Unit
			local up = projectOnSurface(Vector3.yAxis, wwN)
			if up.Magnitude > 0.1 then wwLook = up.Unit end
			wwSpeedNow = 0
			wwStill = 0
			return
		end

		local t = math.clamp(1 - (WW.runUntil - now) / WALLRUN_TIME, 0, 1)
		local vy = 6 - 15 * t * t
		wwSpeedNow += (WALLRUN_SPEED - wwSpeedNow) * (1 - math.exp(-5 * dt))
		local err = (res.Position - pos):Dot(dir) - WALLRUN_DIST
		lv.VectorVelocity = run * wwSpeedNow + dir * math.clamp(err * 18, -20, 20) + Vector3.new(0, vy, 0)
		ao.CFrame = CFrame.lookAt(Vector3.zero, run) * CFrame.Angles(0, 0, WW.side * 0.32)
		wallAttach.WorldPosition = res.Position + wwN * 0.2
		wallAttach.WorldAxis = wwN
		wallDust.Enabled = EFFECTS_ENABLED

		if usable(runTrack) then
			local track = best(runTrack)
			setTrack(track)
			track:AdjustSpeed(1.2)
		else
			setTrack(nil)
		end
	end

	local function updateWallWalk(now, dt)
		if WW.run then
			WW.updateRun(now, dt)
			return
		end
		fallMin = 0
		local pos = root.Position
		local dir = -wwN

		local surfUp = projectOnSurface(Vector3.yAxis, wwN)
		surfUp = surfUp.Magnitude > 0.2 and surfUp.Unit or wwLook
		local rightV = dir:Cross(surfUp)
		local move = hum.MoveDirection
		local vIn, hIn = 0, 0
		if move.Magnitude > 0.1 then
			local tw = Vector3.new(dir.X, 0, dir.Z)
			if tw.Magnitude > 0.1 then
				vIn = move:Dot(tw.Unit)
			end
			hIn = move:Dot(rightV)
		end
		local along = surfUp * vIn + rightV * hIn
		if math.abs(wwN.Y) > 0.7 then
			along = Vector3.new(move.X, 0, move.Z)
		end
		local mag = math.min(along.Magnitude, 1)
		local alongDir = mag > 0.15 and along.Unit or nil
		local want = alongDir and WALLWALK_SPEED * mag or 0
		wwSpeedNow += (want - wwSpeedNow) * (1 - math.exp(-9 * dt))

		local res = WW.find(pos, dir, surfUp, rightV)
		local usedGrace = false

		if alongDir and wwSpeedNow > 1 and alongDir.Y > 0.3 and math.abs(wwN.Y) < 0.5 then
			local upHit = surfaceHit(pos, Vector3.yAxis, WW_CEIL_CATCH)
			if not upHit then upHit = surfaceHit(pos + dir * 1.5, Vector3.yAxis, WW_CEIL_CATCH) end
			if upHit and upHit.Normal.Y < -0.8 then
				local away = Vector3.new(wwN.X, 0, wwN.Z)
				wwN = upHit.Normal.Unit
				res = upHit
				dir = -wwN
				if away.Magnitude > 0.1 then
					alongDir = away.Unit
					wwLook = alongDir
				end
			end
		end

		if alongDir and wwSpeedNow > 1 then
			local reachA = WW_DIST + ((alongDir.Y > 0.3) and 2.2 or 0.6)
			local ahead = surfaceHit(pos, alongDir, reachA)
			if ahead and ahead.Normal:Dot(wwN) < 0.75 then
				if ahead.Normal.Y > 0.8 then
					if alongDir.Y < -0.25 then
						endWallWalk(now)
						return
					end
				else
					local oldN = wwN
					wwN = ahead.Normal.Unit
					res = ahead
					dir = -wwN
					if wwN.Y < -0.8 and math.abs(oldN.Y) < 0.5 then
						local away = Vector3.new(oldN.X, 0, oldN.Z)
						if away.Magnitude > 0.1 then
							alongDir = away.Unit
							wwLook = alongDir
						end
					else
						alongDir = projectOnSurface(alongDir, wwN)
						alongDir = alongDir.Magnitude > 0.1 and alongDir.Unit or nil
					end
				end
			end
		end

		if not res then

			local wrapped
			if alongDir and wwSpeedNow > 1 then
				local p2 = pos + alongDir * 3.5 + dir * (WW_DIST + 0.5)
				local h = surfaceHit(p2, -alongDir, 5)
				if h and math.abs(h.Normal.Y) < 0.8 then
					wrapped = h
				end
			end
			if wrapped then
				wwN = wrapped.Normal.Unit
				res = wrapped
				dir = -wwN
				if alongDir then
					alongDir = projectOnSurface(alongDir, wwN)
					alongDir = alongDir.Magnitude > 0.1 and alongDir.Unit or nil
				end
			else
				local goingUp = alongDir ~= nil and alongDir.Y > 0.5
				WW.lost += dt
				if WW.lastRes and WW.lost <= (goingUp and 0.1 or WW_GRACE) then
					res = WW.lastRes
					usedGrace = true
				else
					local flatIn = Vector3.new(dir.X, 0, dir.Z)
					flatIn = flatIn.Magnitude > 0.1 and flatIn.Unit or Vector3.zero
					endWallWalk(now)
					if goingUp then
						root.AssemblyLinearVelocity = flatIn * MANTLE_FORWARD + Vector3.new(0, MANTLE_UP, 0)
					end
					return
				end
			end
		end
		if not usedGrace then
			WW.lost = 0
			WW.lastRes = res
		end

		local hangMode
		if wwStill >= WALL_IDLE_DELAY then
			if math.abs(wwN.Y) < 0.5 and usable(wallIdleTrack) then
				hangMode = "wall"
			elseif wwN.Y < -0.7 and usable(wallIdleTrack) then
				hangMode = "ceil"
			end
		end
		Hang.active = hangMode
		local hangCfg = hangMode and Hang[hangMode]
		local err = (res.Position - pos):Dot(dir) - (hangCfg and hangCfg.dist or WW_DIST)
		local alongVel = alongDir and (alongDir * wwSpeedNow) or Vector3.zero
		lv.VectorVelocity = alongVel + dir * math.clamp(err * 20, -22, 22)

		if alongDir then
			local target = projectOnSurface(alongDir, wwN)
			if target.Magnitude > 0.05 then
				wwLook = wwLook:Lerp(target.Unit, 1 - math.exp(-14 * dt))
			end
		end
		local keep = projectOnSurface(wwLook, wwN)
		if keep.Magnitude < 0.05 then
			keep = projectOnSurface(Vector3.yAxis, wwN)
			if keep.Magnitude < 0.05 then keep = projectOnSurface(Vector3.zAxis, wwN) end
		end
		wwLook = keep.Unit
		if hangMode == "wall" then
			local faceWall = Vector3.new(-wwN.X, 0, -wwN.Z)
			ao.CFrame = CFrame.lookAt(Vector3.zero, faceWall.Unit) * Hang.rots[hangCfg.rot]
		elseif hangMode == "ceil" then
			local fl = Vector3.new(wwLook.X, 0, wwLook.Z)
			if fl.Magnitude < 0.1 then
				fl = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
			end
			if fl.Magnitude < 0.1 then fl = Vector3.zAxis end
			ao.CFrame = CFrame.lookAt(Vector3.zero, fl.Unit) * Hang.rots[hangCfg.rot]
		else
			ao.CFrame = wwCFrame()
		end

		wallAttach.WorldPosition = res.Position + wwN * 0.2
		wallAttach.WorldAxis = wwN
		wallDust.Enabled = EFFECTS_ENABLED and wwSpeedNow > 3

		if alongDir == nil and wwSpeedNow < 1.5 then
			wwStill += dt
		else
			wwStill = 0
		end
		local idleTrack = wallIdleTrack
		if wwStill >= WALL_IDLE_DELAY and usable(idleTrack) then
			setTrack(best(idleTrack))
			return
		end

		if wwSpeedNow > 1.5 then
			updateTier(wwSpeedNow / WALLWALK_SPEED)
		end
		local entry = (tier == 1 and walkTrack) or (tier == 2 and mediumTrack) or runTrack
		if usable(entry) then
			local track = best(entry)
			setTrack(track)
			if wwSpeedNow > 1.5 then
				track:AdjustSpeed(math.clamp(wwSpeedNow / WW_ANIM_BASE, 0.8, 2.4))
			else
				track:AdjustSpeed(0)
			end
		else
			setTrack(nil)
		end
	end

	local function doWallWalkJump(now)
		local n = wwN
		local alongPush = wwSpeedNow > 2 and wwLook * WW_JUMP_ALONG or Vector3.zero
		local launch = n * WALLJUMP_OUT + alongPush + Vector3.new(0, WALLJUMP_UP, 0)
		if math.abs(n.Y) > 0.7 then
			launch = alongPush + n * 10
		end
		wallDust:Emit(40)
		shockwave(root.Position - n * 2.4, n, Color3.fromRGB(255, 225, 150), 12, 0.45)
		trick("WALL JUMP", "wallJump")
		shake(0.25)
		fovKick = math.max(fovKick, 8)
		endWallWalk(now)

		climbLockUntil = now + 0.12
		chainUntil = now + WALL_CHAIN_TIME
		chainN = n
		local flat = Vector3.new(launch.X, 0, launch.Z)
		if flat.Magnitude > 0.1 then
			root.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
		end
		root.AssemblyLinearVelocity = launch
		jumpActive = true
		fallMode = false
		jumpGrace = now + 0.25
		jumpIndex = pickRandom(jumpTracks, jumpIndex)
	end

	local function tryVault(res, flat, now)
		if not VAULT_ENABLED or hum.FloorMaterial == Enum.Material.Air then return false end
		local floorRes = workspace:Raycast(root.Position, Vector3.new(0, -6, 0), rayParams)
		local feetY = floorRes and floorRes.Position.Y or (root.Position.Y - 3)
		local origin = Vector3.new(res.Position.X, feetY + VAULT_MAX_H + 1, res.Position.Z) + flat * 0.7
		local top = workspace:Raycast(origin, Vector3.new(0, -(VAULT_MAX_H + 1.5), 0), rayParams)
		if not top or top.Normal.Y < 0.7 or isCharacterPart(top.Instance) then return false end
		local h = top.Position.Y - feetY
		if h < 1.6 or h > VAULT_MAX_H then return false end

		if workspace:Raycast(top.Position + Vector3.new(0, 0.3, 0), Vector3.new(0, 5, 0), rayParams) then
			return false
		end
		local v = root.AssemblyLinearVelocity
		local speed = math.max(Vector3.new(v.X, 0, v.Z).Magnitude, VAULT_MIN_SPEED)
		local vy = math.sqrt(2 * workspace.Gravity * (h + 1.4))
		root.AssemblyLinearVelocity = flat * speed + Vector3.new(0, vy, 0)
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
		placeFloorFx()
		floorDust:Emit(12)
		jumpActive = true
		fallMode = false
		jumpGrace = now + 0.3
		jumpIndex = pickRandom(jumpTracks, jumpIndex)
		climbLockUntil = now + 0.5
		trick("VAULT", "wallJump")
		return true
	end

	local function tryStartClimb(state, dt, now)
		if now < climbLockUntil
			or state == Enum.HumanoidStateType.Climbing
			or state == Enum.HumanoidStateType.Swimming
			or state == Enum.HumanoidStateType.Seated
			or hum.Sit then
			pushTime = 0
			return false
		end
		if CEILING_WALK and (state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall) then
			local v = root.AssemblyLinearVelocity
			if v.Y > 4 then
				local up = workspace:Raycast(root.Position, Vector3.new(0, CEILING_REACH, 0), rayParams)
				if up and up.Normal.Y < -0.8 and not isCharacterPart(up.Instance) then
					pushTime = 0
					startWallWalk(up.Normal)
					return true
				end
			end
		end
		if WALLRUN_ENABLED and (state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall) then
			local v = root.AssemblyLinearVelocity
			local fv = Vector3.new(v.X, 0, v.Z)
			local mdv = hum.MoveDirection
			if fv.Magnitude > WALLRUN_MIN_SPEED and mdv.Magnitude > 0.1
				and mdv:Dot(fv.Unit) > 0.2
				and not workspace:Raycast(root.Position, Vector3.new(0, -5.5, 0), rayParams) then
				local fd = fv.Unit
				local right = fd:Cross(Vector3.yAxis)
				for _, side in ipairs({1, -1}) do
					local wr = wallHit(root.Position, right * side, WALLRUN_REACH)
					if wr and math.abs(fd:Dot(wr.Normal)) < 0.5
						and not (now < chainUntil and chainN and wr.Normal:Dot(chainN) > 0.7) then
						pushTime = 0
						WW.start(wr, fd, side, fv.Magnitude, now)
						return true
					end
				end
			end
		end
		local md = hum.MoveDirection
		local flat = Vector3.new(md.X, 0, md.Z)
		if flat.Magnitude < 0.1 then
			pushTime = 0
			return false
		end
		flat = flat.Unit
		local chaining = now < chainUntil
		local res = wallHit(root.Position, flat, chaining and WALL_CHAIN_REACH or CLIMB_REACH)
		if res and chaining and chainN and res.Normal:Dot(chainN) > 0.7 then
			res = nil
		end
		if res and flat:Dot(-res.Normal) > 0.6 then
			pushTime += dt
			if pushTime >= (chaining and 0 or CLIMB_START_DELAY) then
				pushTime = 0
				if tryVault(res, flat, now) then return true end
				if wallWalkMode then
					startWallWalk(res.Normal)
				else
					startClimb(res.Normal)
				end
				return true
			end
		else
			pushTime = 0
		end
		return false
	end

	local sliding = false
	local pendingSlide
	local slideDir, slideBase, slideSpeed = Vector3.zAxis, 16, 18
	local slideStart, slideStyle, slideTrack = 0, "knee", nil
	local slideCooldownUntil = 0

	local function faceDownCFrame(dir)

		local up = dir
		local back = Vector3.yAxis
		return CFrame.fromMatrix(Vector3.zero, up:Cross(back), up, back)
	end

	local function startSlide(now)
		local md = hum.MoveDirection
		local flat = Vector3.new(md.X, 0, md.Z)
		if flat.Magnitude < 0.1 then
			local v = root.AssemblyLinearVelocity
			flat = Vector3.new(v.X, 0, v.Z)
		end
		if flat.Magnitude < 0.1 then
			flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		end
		slideDir = flat.Unit
		slideBase = curSpeed
		slideSpeed = slideBase * SLIDE_BOOST
		slideStart = now
		fallMin = 0
		local fp = placeFloorFx()
		floorDust:Emit(40)
		floorSparks:Emit(20)
		shockwave(fp, Vector3.yAxis, Color3.fromRGB(120, 200, 255), 18, 0.55)
		setSlideFx(true)
		trick("SLIDE", "slide")
		shake(0.25)
		fovKick = math.max(fovKick, 10)

		local style = SLIDE_STYLE
		if style == "random" then
			style = math.random() < 0.5 and "knee" or "belly"
		end
		if style == "knee" and not usable(kneeTrack) and usable(bellyTrack) then style = "belly" end
		if style == "belly" and not usable(bellyTrack) and usable(kneeTrack) then style = "knee" end
		slideStyle = style

		sliding = true
		hum.PlatformStand = true
		hum.AutoRotate = false
		lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
		lv.PrimaryTangentAxis = Vector3.xAxis
		lv.SecondaryTangentAxis = Vector3.zAxis
		lv.PlaneVelocity = Vector2.new(slideDir.X * slideSpeed, slideDir.Z * slideSpeed)
		lv.Enabled = true
		ao.CFrame = style == "belly" and faceDownCFrame(slideDir) or CFrame.lookAt(Vector3.zero, slideDir)
		ao.Enabled = true

		local entry = style == "belly" and bellyTrack or kneeTrack
		slideTrack = usable(entry) and best(entry) or nil
		setTrack(slideTrack)
		if slideTrack and style == "belly" then
			slideTrack.TimePosition = slideTrack.Length * BELLY_FREEZE_AT
			slideTrack:AdjustSpeed(0)
		end
		jumpActive = false
	end

	local function endSlide(now)
		sliding = false
		lv.Enabled = false
		ao.Enabled = false
		local lift = slideStyle == "belly" and 2.5 or 1.5
		local pos = root.Position + Vector3.new(0, lift, 0)
		root.CFrame = CFrame.lookAt(pos, pos + slideDir)
		hum.PlatformStand = false
		hum.AutoRotate = true

		local newSpeed = math.max(slideBase * SLIDE_END_SPEED, 1)
		applySpeed(newSpeed)
		root.AssemblyLinearVelocity = slideDir * newSpeed
		hum:ChangeState(Enum.HumanoidStateType.Running)
		setSlideFx(false)

		slideCooldownUntil = now + SLIDE_COOLDOWN
		wasMoving = true
		smoothSpeed = slideBase * SLIDE_END_SPEED
		tier = 2
		slideTrack = nil
		setTrack(nil)
	end

	local function updateSlide(now)
		local t = now - slideStart
		placeFloorFx()
		lv.PlaneVelocity = Vector2.new(slideDir.X * slideSpeed, slideDir.Z * slideSpeed)
		ao.CFrame = slideStyle == "belly" and faceDownCFrame(slideDir) or CFrame.lookAt(Vector3.zero, slideDir)

		if slideTrack and slideStyle == "knee" and slideTrack.Length > 0
			and slideTrack.TimePosition >= slideTrack.Length - 0.08 then
			slideTrack:AdjustSpeed(0)
		end

		local blocked = wallHit(root.Position, slideDir, 3) ~= nil
		if t >= SLIDE_TIME or blocked then
			endSlide(now)
		end
	end

	local swinging = false
	local swingAnchor = Vector3.zero
	local swingVel, swingLastOut = Vector3.zero, Vector3.zero
	local ropeLen, ropeMin = 30, 14
	local ropePart
	local swingStart, swingCooldownUntil = 0, 0
	local swingIndex = 0
	local swingSlowFor, hanging = 0, false
	local nextScan, lastAnchorSeen = 0, 0

	local function findSwingAnchor()
		local cam = workspace.CurrentCamera
		local look = cam and cam.CFrame.LookVector or root.CFrame.LookVector
		local fwd = Vector3.new(look.X, 0, look.Z)
		if fwd.Magnitude < 0.1 then
			fwd = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		end
		if fwd.Magnitude < 0.1 then
			fwd = Vector3.zAxis
		end
		fwd = fwd.Unit
		local origin = root.Position + Vector3.new(0, 1.5, 0)
		local bestPos, bestScore
		for _, elev in ipairs({35, 50, 65, 80, 90}) do
			for _, yaw in ipairs({0, 20, -20, 40, -40}) do
				local flatDir = CFrame.Angles(0, math.rad(yaw), 0) * fwd
				local d = flatDir * math.cos(math.rad(elev)) + Vector3.new(0, math.sin(math.rad(elev)), 0)
				local r = workspace:Raycast(origin, d * SWING_RANGE, rayParams)
				if r and not isCharacterPart(r.Instance)
					and r.Position.Y > root.Position.Y + SWING_MIN_HEIGHT then
					local dist = (r.Position - origin).Magnitude
					if dist >= SWING_MIN_DIST then
						local score = math.abs(dist - SWING_IDEAL_DIST) + math.abs(yaw) * 0.25 + math.abs(elev - 50) * 0.15
						if not bestScore or score < bestScore then
							bestPos, bestScore = r.Position, score
						end
					end
				end
			end
		end
		return bestPos
	end

	local function swingCFrame(vel)
		local toA = swingAnchor - root.Position
		local dir = toA.Magnitude > 0.1 and toA.Unit or Vector3.yAxis
		local up = (dir + Vector3.yAxis * 0.35).Unit
		local look = Vector3.new(vel.X, 0, vel.Z)
		if look.Magnitude < 1 then
			look = Vector3.new(dir.X, 0, dir.Z)
		end
		if look.Magnitude < 0.05 then
			look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		end
		look = look - up * look:Dot(up)
		if look.Magnitude < 0.05 then
			look = Vector3.zAxis - up * Vector3.zAxis:Dot(up)
		end
		look = look.Unit
		return CFrame.fromMatrix(Vector3.zero, look:Cross(up), up, -look)
	end

	local function startSwing(anchor, now)
		swinging = true
		swingAnchor = anchor
		swingStart = now
		local toA = anchor - root.Position
		ropeLen = toA.Magnitude
		ropeMin = math.min(ropeLen, SWING_ARM)

		local v = root.AssemblyLinearVelocity
		local flatTo = Vector3.new(toA.X, 0, toA.Z)
		if flatTo.Magnitude > 0.1 then
			v = v + flatTo.Unit * SWING_START_BOOST
		end
		if hum.FloorMaterial ~= Enum.Material.Air then
			v = v + Vector3.new(0, SWING_HOP, 0)
		end
		swingVel, swingLastOut = v, v

		hum.PlatformStand = true
		hum.AutoRotate = false
		lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
		lv.VectorVelocity = v
		lv.Enabled = true
		ao.CFrame = swingCFrame(v)
		ao.Enabled = true

		if ropePart then ropePart:Destroy() end
		ropePart = Instance.new("Part")
		ropePart.Name = "CustomAnimRopeAnchor"
		ropePart.Anchored = true
		ropePart.CanCollide = false
		ropePart.CanQuery = false
		ropePart.CanTouch = false
		ropePart.CastShadow = false
		ropePart.Transparency = 1
		ropePart.Size = Vector3.one * 0.2
		ropePart.CFrame = CFrame.new(anchor)
		local a0 = Instance.new("Attachment")
		a0.Parent = ropePart
		local beam = Instance.new("Beam")
		beam.Attachment0 = a0
		beam.Attachment1 = handAttach
		beam.Width0 = 0.16
		beam.Width1 = 0.1
		beam.Segments = 1
		beam.FaceCamera = true
		beam.LightEmission = 0.2
		beam.Color = ColorSequence.new(Color3.fromRGB(235, 235, 235))
		beam.Transparency = NumberSequence.new(0.1)
		beam.Enabled = SHOW_ROPE
		beam.Parent = ropePart
		ropePart.Parent = workspace

		swingIndex = pickRandom(swingTracks, swingIndex)
		swingSlowFor, hanging = 0, false
		trick("SWING", "grab")
		fallMin = 0
		jumpActive = false
		fallMode = false
		fovKick = math.max(fovKick, 6)
		shake(0.1)
	end

	local function endSwing(now, jumped)
		swinging = false
		if ropePart then
			ropePart:Destroy()
			ropePart = nil
		end
		lv.Enabled = false
		ao.Enabled = false
		local vel = root.AssemblyLinearVelocity
		if vel.Magnitude < 1 then vel = swingVel end
		local face = Vector3.new(vel.X, 0, vel.Z)
		if face.Magnitude < 1 then
			face = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		end
		if face.Magnitude < 0.1 then face = Vector3.zAxis end
		face = face.Unit
		root.CFrame = CFrame.lookAt(root.Position, root.Position + face)
		hum.PlatformStand = false
		hum.AutoRotate = true
		root.AssemblyLinearVelocity = vel * SWING_RELEASE_MULT
			+ Vector3.new(0, jumped and SWING_JUMP_BOOST or SWING_RELEASE_UP, 0)
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
		swingCooldownUntil = now + 0.25
		if now - swingStart > 0.4 then trick("RELEASE", "release") end
		climbLockUntil = now + 0.3
		fovKick = math.max(fovKick, jumped and 10 or 6)
		if jumped then
			shake(0.12)
			jumpActive = true
			fallMode = false
			jumpGrace = now + 0.25
			jumpIndex = pickRandom(jumpTracks, jumpIndex)
		end
	end

	local function updateSwing(now, dt)
		if not Input.swing or now - swingStart > SWING_MAX_TIME then
			endSwing(now, false)
			return
		end
		fallMin = 0
		local pos = root.Position

		local actual = root.AssemblyLinearVelocity
		if (actual - swingLastOut).Magnitude > 22 then
			swingVel = actual
		end

		swingVel = swingVel + Vector3.new(0, -workspace.Gravity * SWING_GRAVITY, 0) * dt
		local move = hum.MoveDirection
		if move.Magnitude > 0.1 then
			swingVel = swingVel + Vector3.new(move.X, 0, move.Z) * SWING_PUMP * dt
		end
		ropeLen = math.max(ropeMin, ropeLen - SWING_HAUL_SPEED * dt)

		local toA = swingAnchor - pos
		local dist = toA.Magnitude
		local corr = Vector3.zero
		if dist > 0.5 then
			local d = toA / dist
			if dist >= ropeLen - 0.1 then
				local radial = swingVel:Dot(d)
				if radial < 0 then
					swingVel = swingVel - d * radial
				end
			end
			if dist > ropeLen then
				corr = d * math.min((dist - ropeLen) * 14, SWING_HAUL_SPEED)
			end
		end
		local drag = SWING_DRAG
		if now - swingStart > SWING_SETTLE_AFTER and move.Magnitude < 0.1 then
			drag = SWING_SETTLE_DRAG
		end
		swingVel = swingVel * math.max(0, 1 - drag * dt)
		if swingVel.Magnitude > SWING_MAX_SPEED then
			swingVel = swingVel.Unit * SWING_MAX_SPEED
		end
		swingLastOut = swingVel + corr
		lv.VectorVelocity = swingLastOut
		ao.CFrame = swingCFrame(swingVel)

		if now - swingStart > 0.4 and swingVel.Y < 2 then
			if workspace:Raycast(pos, Vector3.new(0, -3.6, 0), rayParams) then
				endSwing(now, false)
				return
			end
		end

		local spd = swingVel.Magnitude
		if hanging then
			if spd > HANG_SPEED * 2 then hanging = false end
			swingSlowFor = 0
		else
			if spd < HANG_SPEED then swingSlowFor += dt else swingSlowFor = 0 end
			if swingSlowFor >= HANG_DELAY then hanging = true end
		end
		local sw = swingTracks[swingIndex]
		if hanging and usable(swingHangTrack) then
			setTrack(best(swingHangTrack))
		elseif sw and usable(sw) then
			setTrack(best(sw))
		else
			playFall()
		end
	end

	local function trySwing(now)
		if sliding then return false end
		local anchor = Swing.anchor
		if not anchor then return false end
		if climbing then endClimb() end
		if wallWalking then endWallWalk(now) end
		startSwing(anchor, now)
		return true
	end

	local function setStance(n)
		if stance == n then return end
		stance = n
		Hud.crawling = (n == 2)
		if n == 0 then
			applySpeed(startSpeedFor(targetSpeed))
			setTrack(nil)
		else
			if n == 1 then
				crouchIndex = pickRandom(crouchTracks, crouchIndex)
			else
				crawlIndex = pickRandom(crawlTracks, crawlIndex)
			end
			applySpeed(n == 1 and CROUCH_SPEED or CRAWL_SPEED)
			setTrack(nil)
		end
	end

	local function handleStance(req, now)
		if swinging or climbing or wallWalking or sliding or hum.Sit then return end
		if hum.FloorMaterial == Enum.Material.Air then return end
		if req == "cycle" then
			setStance(stance == 0 and 2 or 0)
		elseif req == "crawl" then
			setStance(stance == 2 and 0 or 2)
		end
	end

	local crouchMove, crouchAmt, crouchPhase = 0, 0, 0
	local function motor(partName, jointName)
		local p = char:FindFirstChild(partName)
		return p and p:FindFirstChild(jointName)
	end
	local hipL, hipR = motor("LeftUpperLeg", "LeftHip"), motor("RightUpperLeg", "RightHip")
	local kneeL, kneeR = motor("LeftLowerLeg", "LeftKnee"), motor("RightLowerLeg", "RightKnee")
	local legConn
	legConn = RunService.RenderStepped:Connect(function(dt)
		if not alive then
			legConn:Disconnect()
			return
		end
		local want = (stance == 1 and crouchMove > 0.8 and currentTrack and currentTrack.IsPlaying) and 1 or 0
		crouchAmt = crouchAmt + (want - crouchAmt) * math.min(1, dt * 12)
		if crouchAmt < 0.02 or not (hipL and hipR and kneeL and kneeR) then return end
		crouchPhase = crouchPhase + dt * math.clamp(crouchMove, 0, 14) * 0.9
		local s = math.sin(crouchPhase)
		local k = crouchAmt
		hipL.Transform = hipL.Transform * CFrame.Angles(s * 0.55 * k, 0, 0)
		hipR.Transform = hipR.Transform * CFrame.Angles(-s * 0.55 * k, 0, 0)
		kneeL.Transform = kneeL.Transform * CFrame.Angles(-math.max(0, -s) * 0.6 * k, 0, 0)
		kneeR.Transform = kneeR.Transform * CFrame.Angles(-math.max(0, s) * 0.6 * k, 0, 0)
	end)

	local emoteEntry, emoteSerial = nil, 0
	local emoteCache, emoteOrder = {}, {}
	local function startEmote(id)
		emoteSerial += 1
		local serial = emoteSerial
		local entry = emoteCache[id]
		if not entry then
			entry = loadTrack(id, "Emote " .. id, true)
			emoteCache[id] = entry
			table.insert(emoteOrder, id)
			if #emoteOrder > 8 then
				local oldId = table.remove(emoteOrder, 1)
				local oldEntry = emoteCache[oldId]
				emoteCache[oldId] = nil
				if oldEntry then
					if oldEntry == emoteEntry then emoteEntry = nil end
					for _, t in ipairs(oldEntry.tracks) do
						t:Stop(0)
						t:Destroy()
					end
				end
			end
		end
		bump(entry)
		local started = os.clock()
		local function ready()
			local b = entry.loaded and best(entry)
			return b and b.Length > 0
		end
		while alive and serial == emoteSerial and not ready() and os.clock() - started < 8 do
			task.wait(0.1)
		end
		if alive and serial == emoteSerial and ready() then
			emoteEntry = entry
		else
			warn("[CustomAnims] That emote could not be loaded (blocked in this game or not an animation).")
		end
	end

	local function doDoubleJump(now)
		doubleUsed = true
		local v = root.AssemblyLinearVelocity
		root.AssemblyLinearVelocity = Vector3.new(v.X, DOUBLE_JUMP_POWER, v.Z)
		local len = FLIP_TIME
		if usable(flipTrack) then
			local t = best(flipTrack)
			if t.Length > 0.3 then
				len = math.clamp(t.Length, 0.5, 1.2)
			end
			t:Stop(0)
			if currentTrack == t then currentTrack = nil end
		end
		flipUntil = now + len
		jumpActive = true
		fallMode = false
		jumpGrace = now + 0.3
		wind:Emit(14)
		trick("FLIP", "flip")
		shake(0.06)
		fovKick = math.max(fovKick, 5)
	end

	local dashUntil, dashCooldownUntil = 0, 0
	local dashDir = Vector3.zAxis
	local dashHandled = os.clock()

	local function doDash(now)
		if now < dashCooldownUntil or sliding or swinging or climbing or wallWalking then return end
		local cam = workspace.CurrentCamera
		local md = hum.MoveDirection
		local d = Vector3.new(md.X, 0, md.Z)
		if d.Magnitude < 0.1 and cam then
			d = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
		end
		if d.Magnitude < 0.1 then
			d = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		end
		if d.Magnitude < 0.1 then d = Vector3.zAxis end
		dashDir = d.Unit
		dashUntil = now + DASH_TIME
		dashCooldownUntil = now + DASH_COOLDOWN

		local grounded = hum.FloorMaterial ~= Enum.Material.Air
		local cv = root.AssemblyLinearVelocity
		root.CFrame = CFrame.lookAt(root.Position, root.Position + dashDir)
		root.AssemblyLinearVelocity = Vector3.new(
			dashDir.X * DASH_SPEED,
			grounded and 14 or math.max(cv.Y, 4),
			dashDir.Z * DASH_SPEED
		)
		if grounded then
			hum:ChangeState(Enum.HumanoidStateType.Freefall)
			placeFloorFx()
			floorDust:Emit(12)
		end
		wind:Emit(18)
		trick("DASH", "dash")
		shake(0.12)
		fovKick = math.max(fovKick, 12)
		jumpActive = true
		fallMode = false
		jumpGrace = now + 0.3
		jumpIndex = pickRandom(jumpTracks, jumpIndex)
	end

	local lastEvent, lastPress, tapWasMoving = 0, 0, false
	local jumpConn
	jumpConn = UserInputService.JumpRequest:Connect(function()
		if not alive then return end
		local now = os.clock()
		if swinging then
			endSwing(now, true)
			return
		end
		if climbing then
			doWallJump(now)
			return
		end
		if wallWalking then
			doWallWalkJump(now)
			return
		end
		if sliding then return end

		local isRepeat = now - lastEvent < JUMP_REPEAT_GAP
		lastEvent = now
		if isRepeat then return end

		if stance > 0 then
			setStance(0)
			return
		end

		if DOUBLE_JUMP_ENABLED and not doubleUsed and not hum.Sit
			and hum.FloorMaterial == Enum.Material.Air then
			doDoubleJump(now)
			return
		end

		if doubleUsed and not hum.Sit and hum.FloorMaterial == Enum.Material.Air
			and now > slideCooldownUntil and not pendingSlide then
			local v = root.AssemblyLinearVelocity
			pendingSlide = now + 1.5
			flipUntil = 0
			root.AssemblyLinearVelocity = Vector3.new(v.X, -SLAM_SPEED, v.Z)
		end
	end)

	local conn
	Core.kill = function()
		if Core.dead then return end
		Core.dead = true
		alive = false
		if conn then conn:Disconnect() end
		if jumpConn then jumpConn:Disconnect() end
		if legConn then legConn:Disconnect() end
		for _, c in ipairs(Core.conns) do c:Disconnect() end
		Swing.anchor = nil
		Hud.mode = ""
		Input.swing = false
		swingHeldInput = nil
		if ropePart then ropePart:Destroy() ropePart = nil end
		setTrack(nil)
		for _, e in ipairs(Core.entries) do
			for _, t in ipairs(e.tracks) do
				pcall(function()
					t:Stop(0)
					t:Destroy()
				end)
			end
		end
		pcall(function()
			lv.Enabled = false
			ao.Enabled = false
			hum.CameraOffset = Vector3.zero
		end)
		for _, o in ipairs({attach, lv, ao, floorAttach, wallAttach, feetAttach, handAttach, wind, trickSparks}) do
			pcall(function() o:Destroy() end)
		end
		pcall(function()
			if hum.Health > 0 and hum:GetState() ~= Enum.HumanoidStateType.Dead then
				hum.PlatformStand = false
				hum.AutoRotate = true
				local base = hum:GetAttribute("CA_BaseWS")
				if base then hum.WalkSpeed = base end
			end
		end)
		for i, f in ipairs(Session.kills) do
			if f == Core.kill then
				table.remove(Session.kills, i)
				break
			end
		end
	end
	table.insert(Session.kills, Core.kill)

	conn = RunService.Heartbeat:Connect(function(dt)
		if not char.Parent or hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then
			Core.kill()
			return
		end

		local now = os.clock()
		pollExternalSpeed()

		local v0 = root.AssemblyLinearVelocity
		fallMin = math.min(fallMin, v0.Y)
		local flat0 = Vector3.new(v0.X, 0, v0.Z).Magnitude
		local fxA = math.clamp(flat0 / FOV_FULL_SPEED, 0, 1)
		Hud.mode = swinging and "swing" or (sliding and "slide" or (wallWalking and "wall" or ""))
		local fxColor = speedColor(fxA)
		local grounded = hum.FloorMaterial ~= Enum.Material.Air
		if grounded then
			if now - AirT.last > 0.2 then AirT.peak = root.Position.Y end
		else
			AirT.last = now
			if root.Position.Y > AirT.peak then AirT.peak = root.Position.Y end
		end
		wind.Enabled = EFFECTS_ENABLED and flat0 > WIND_MIN_SPEED and not climbing and not wallWalking
		wind.Rate = 10 + 35 * fxA
		wind.Color = ColorSequence.new(fxColor)
		runPuff.Enabled = EFFECTS_ENABLED and (
			(grounded and not sliding and not climbing and not swinging and flat0 > PUFF_MIN_SPEED)
			or (wallWalking and wwSpeedNow > 6)
		)

		if shakeMag > 0.005 then
			shakeMag = shakeMag * math.exp(-8 * dt)
			hum.CameraOffset = Vector3.new((math.random() - 0.5) * shakeMag, (math.random() - 0.5) * shakeMag, 0)
		elseif shakeMag > 0 then
			shakeMag = 0
			hum.CameraOffset = Vector3.zero
		end

		if not climbing and not sliding and not wallWalking and not swinging and stance == 0 then
			local start = startSpeedFor(targetSpeed)
			local isMoving = hum.MoveDirection.Magnitude > 0.1
			local rate = (targetSpeed - start) / rampDuration(targetSpeed)
			local desired = isMoving and targetSpeed or start
			if curSpeed < desired then
				applySpeed(math.min(desired, curSpeed + rate * dt))
			elseif curSpeed > desired then

				local step = isMoving and math.huge or rate * STOP_DECAY * dt
				applySpeed(math.max(desired, curSpeed - step))
			end
		end

		if grounded or climbing or wallWalking or swinging then
			doubleUsed = false
		end
		if stance > 0 and (swinging or climbing or wallWalking or sliding) then
			setStance(0)
		end
		if emoteEntry and (swinging or climbing or wallWalking or sliding) then
			emoteEntry = nil
		end

		if swinging then
			Swing.anchor = swingAnchor
		elseif now >= nextScan then
			nextScan = now + 0.12
			local found = (not sliding and not hum.Sit) and findSwingAnchor() or nil
			if found then
				Swing.anchor = found
				lastAnchorSeen = now
			elseif now - lastAnchorSeen > 0.35 then
				Swing.anchor = nil
			end
		end

		if Input.dashAt > dashHandled then
			dashHandled = Input.dashAt
			doDash(now)
		end
		local ereq = Emote.pending
		if ereq then
			Emote.pending = nil
			task.spawn(startEmote, ereq)
		end
		local req = Input.stance
		if req then
			Input.stance = nil
			handleStance(req, now)
		end
		if Input.swing and not swinging and now - Input.swingAt < 0.4 and now > swingCooldownUntil then
			trySwing(now)
		end

		if swinging then
			updateSwing(now, dt)
			return
		end
		if climbing then
			updateClimb(now)
			return
		end
		if wallWalking then
			updateWallWalk(now, dt)
			return
		end
		if sliding then
			updateSlide(now)
			return
		end

		if now < dashUntil then
			local cv = root.AssemblyLinearVelocity
			root.AssemblyLinearVelocity = Vector3.new(dashDir.X * DASH_SPEED, cv.Y, dashDir.Z * DASH_SPEED)
		end

		if rollPending then
			rollPending = false
			if not pendingSlide and usable(rollTrack) then
				local v = root.AssemblyLinearVelocity
				local flat = Vector3.new(v.X, 0, v.Z)
				local md = hum.MoveDirection
				local d
				if flat.Magnitude > 4 then
					d = flat.Unit
				elseif md.Magnitude > 0.1 then
					d = Vector3.new(md.X, 0, md.Z).Unit
				end
				if d then
					rollDir = d
					rollSpeed = math.max(flat.Magnitude, ROLL_MIN_SPEED)
					local t = best(rollTrack)
					local len = ROLL_TIME
					if t.Length > 0.3 then len = math.clamp(t.Length, 0.4, 1.4) end
					t:Stop(0)
					if currentTrack == t then currentTrack = nil end
					rollUntil = now + len
					rollActive = true
					hum.AutoRotate = false
					root.CFrame = CFrame.lookAt(root.Position, root.Position + rollDir)
					placeFloorFx()
					floorDust:Emit(18)
					shake(0.1)
					trick("ROLL", "roll")
				end
			end
		end
		if rollActive then
			if now >= rollUntil or not grounded then
				rollActive = false
				hum.AutoRotate = true
				wasMoving = true
				smoothSpeed = rollSpeed
			else
				local cv = root.AssemblyLinearVelocity
				root.AssemblyLinearVelocity = Vector3.new(rollDir.X * rollSpeed, cv.Y, rollDir.Z * rollSpeed)
				setTrack(best(rollTrack))
				return
			end
		end

		local state = hum:GetState()

		if pendingSlide then
			if now > pendingSlide then
				pendingSlide = nil
			elseif hum.FloorMaterial ~= Enum.Material.Air and state ~= Enum.HumanoidStateType.Jumping then
				pendingSlide = nil
				startSlide(now)
				return
			end
		end

		if tryStartClimb(state, dt, now) then
			return
		end

		if emoteEntry and (hum.MoveDirection.Magnitude > 0.1 or stance > 0
			or state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall) then
			emoteEntry = nil
			setTrack(nil)
		end

		if stance > 0 and (state == Enum.HumanoidStateType.Jumping
			or state == Enum.HumanoidStateType.Freefall) then
			setStance(0)
		end

		if now < flipUntil and hum.FloorMaterial == Enum.Material.Air and usable(flipTrack) then
			setTrack(best(flipTrack))
			return
		end

		if state == Enum.HumanoidStateType.Jumping
			or (state == Enum.HumanoidStateType.Freefall and jumpActive) then
			if not jumpActive then
				jumpActive = true
				fallMode = false
				jumpIndex = pickRandom(jumpTracks, jumpIndex)
			end
			local jt = jumpTracks[jumpIndex]
			local jtrack = (jt and usable(jt)) and best(jt) or nil
			if fallMode then
				playFall()
			elseif state == Enum.HumanoidStateType.Freefall
				and (not jtrack or (currentTrack == jtrack and not jtrack.IsPlaying)) then
				playFall()
			elseif jtrack then
				setTrack(jtrack)
			else
				setTrack(nil)
			end
			return
		end
		if now > jumpGrace then
			jumpActive = false
		end

		if state == Enum.HumanoidStateType.Freefall then
			playFall()
			return
		end
		fallMode = false

		if state == Enum.HumanoidStateType.Freefall
			or state == Enum.HumanoidStateType.FallingDown
			or state == Enum.HumanoidStateType.Climbing
			or state == Enum.HumanoidStateType.Swimming
			or state == Enum.HumanoidStateType.Seated
			or hum.Sit then
			setTrack(nil)
			return
		end

		crouchMove = 0
		if stance > 0 then
			local sv = root.AssemblyLinearVelocity
			local sFlat = Vector3.new(sv.X, 0, sv.Z).Magnitude
			local entry = stance == 1 and crouchTracks[crouchIndex] or crawlTracks[crawlIndex]
			if entry and usable(entry) then
				local track = best(entry)
				setTrack(track)
				local movingNow = hum.MoveDirection.Magnitude > 0.1 and sFlat > 0.8
				if stance == 1 then

					track:AdjustSpeed(0)
					crouchMove = movingNow and sFlat or 0
				elseif movingNow then
					track:AdjustSpeed(math.clamp(sFlat / STANCE_ANIM_BASE, 0.6, 1.6))
				else
					track:AdjustSpeed(0)
				end
			else
				setTrack(nil)
			end
			wasMoving = false
			return
		end

		local vel = root.AssemblyLinearVelocity
		local flatSpeed = Vector3.new(vel.X, 0, vel.Z).Magnitude
		local moving = hum.MoveDirection.Magnitude > 0.1 and flatSpeed > 1

		if moving then
			if not wasMoving then
				smoothSpeed = flatSpeed
				tier = 1
			else
				smoothSpeed = smoothSpeed + (flatSpeed - smoothSpeed) * math.min(1, dt * 10)
			end
			wasMoving = true

			updateTier(smoothSpeed / math.max(maxSpeed(), 0.1))

			local entry = (tier == 1 and walkTrack) or (tier == 2 and mediumTrack) or runTrack
			if usable(entry) then
				local track = best(entry)
				setTrack(track)
				if tier == 3 then
					track:AdjustSpeed(math.clamp(smoothSpeed / RUN_BASE_SPEED, 1, MAX_RUN_SPEEDUP))
				end
			else
				setTrack(nil)
			end
		else
			smoothSpeed = 0
			if wasMoving then
				wasMoving = false
				nextIdle()
			end
			if emoteEntry and usable(emoteEntry) then
				setTrack(best(emoteEntry))
				return
			end
			if Emote.idleOff then
				setTrack(nil)
				return
			end
			local idle = idleTracks[idleIndex]
			if usable(idle) then
				setTrack(best(idle))
			else
				nextIdle()
				setTrack(nil)
			end
		end
	end)
end

