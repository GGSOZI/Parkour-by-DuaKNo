local sfxCache = {}
local function playSfx(name, volume, pitch)
	Haptic.event(name)
	if not SFX_ENABLED then return end
	local id = SFX[name]
	if not id then return end
	local s = sfxCache[name]
	if not s then
		s = Instance.new("Sound")
		s.Name = name
		s.SoundId = id
		s.Parent = sfxFolder
		sfxCache[name] = s
	end
	s.Volume = SFX_VOLUME * (volume or 1)
	s.PlaybackSpeed = (pitch or 1) * (0.95 + math.random() * 0.1)
	s.TimePosition = 0
	s:Play()
end

