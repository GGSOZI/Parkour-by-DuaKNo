local fovKick = 0
do
	local fov = MIN_FOV
	local oldBlur = Lighting:FindFirstChild("CustomAnimSpeedBlur")
	if oldBlur then oldBlur:Destroy() end
	local blur = Instance.new("BlurEffect")
	blur.Name = "CustomAnimSpeedBlur"
	blur.Size = 0
	blur.Parent = Lighting
	if FOV_ENABLED then
		local cam = workspace.CurrentCamera
		if cam then fov = math.clamp(cam.FieldOfView, MIN_FOV, MAX_FOV) end
		RunService.RenderStepped:Connect(function(dt)
			local camera = workspace.CurrentCamera
			if not camera then return end
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local speed = 0
			if root then
				local v = root.AssemblyLinearVelocity
				speed = Vector3.new(v.X, 0, v.Z).Magnitude
			end
			fovKick = fovKick * math.exp(-5 * dt)
			local target = MIN_FOV + (MAX_FOV - MIN_FOV) * math.clamp(speed / FOV_FULL_SPEED, 0, 1) + fovKick
			fov = fov + (target - fov) * (1 - math.exp(-FOV_SMOOTH * dt))
			camera.FieldOfView = math.clamp(fov, MIN_FOV, MAX_FOV + FOV_KICK_ALLOWANCE)

			local b = math.clamp((speed - 30) / 40, 0, 1) * MAX_BLUR + fovKick * 0.4
			blur.Size = blur.Size + (math.min(b, MAX_BLUR + 4) - blur.Size) * 0.2
		end)
	end
end

