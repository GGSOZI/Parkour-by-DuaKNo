			tab = t
			emotesView.Visible = (t == "emotes")
			customView.Visible = (t == "custom")
			styleTab(tabEmotes, t == "emotes")
			styleTab(tabCustom, t == "custom")
			if t == "emotes" then
				layout()
				if #items == 0 and not loading then fetchMore() end
				render()
			else
				refreshCustom()
			end
		end

		function setOpen(on)
			panel.Visible = on
			if on then
				layout()
				setTab(tab)
			else
				pickKey = nil
				updateHint()
			end
		end

