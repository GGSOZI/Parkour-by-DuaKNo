function UI.edgeColor(t)
	local n = #UI.EDGE
	local x = (t / 14 % 1) * n
	local i = math.floor(x)
	local f = x - i
	f = f * f * (3 - 2 * f)
	return UI.EDGE[i % n + 1]:Lerp(UI.EDGE[(i + 1) % n + 1], f)
end
