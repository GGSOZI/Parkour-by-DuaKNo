	local function pickRandom(list, last)
		local options = {}
		for i = 1, #list do
			if usable(list[i]) and (i ~= last or #list == 1) then
				table.insert(options, i)
			end
		end
		if #options == 0 then
			for i = 1, #list do
				if usable(list[i]) then table.insert(options, i) end
			end
		end
		if #options > 0 then
			return options[math.random(#options)]
		end
		return 0
	end

