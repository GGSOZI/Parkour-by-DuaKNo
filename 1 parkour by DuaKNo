local function bindCharacter(char)
	local hum = char:WaitForChild("Humanoid")
	local root = char:WaitForChild("HumanoidRootPart")
	local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 5)
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = hum
	end

	local alive = true

	local Core = {entries = {}, conns = {}, dead = false}
	for _, ch in ipairs(root:GetChildren()) do
		if string.sub(ch.Name, 1, 10) == "CustomAnim" then ch:Destroy() end
	end
	if hum:GetAttribute("CA_BaseWS") == nil then
		hum:SetAttribute("CA_BaseWS", hum.WalkSpeed)
	end

	local loadQueue = {}
	local function loadTrack(id, name, looped)
		local entry = {id = id, name = name, looped = looped, tracks = {}, loaded = false, loading = false, bumped = false, t0 = 0, gen = 0}
		table.insert(loadQueue, entry)
		table.insert(Core.entries, entry)
		return entry
	end

	local function ensureLoaded(entry)
		if entry.loaded or entry.loading then return end
		entry.loading = true
		local gen = entry.gen
		local candidates = getCandidates(entry.id)
		if not alive or gen ~= entry.gen then return end
		for _, anim in ipairs(candidates) do
			local ok, track = pcall(function()
				return animator:LoadAnimation(anim)
			end)
			if ok and track then
				track.Looped = entry.looped
				track.Priority = PRIORITY
				table.insert(entry.tracks, track)
			end
		end
		entry.t0 = os.clock()
		entry.loaded = true
		task.delay(5, function()
			if not alive then return end
			local good
			for _, t in ipairs(entry.tracks) do
				if t.Length > 0 then good = t break end
			end
			if not good then
				warn("[CustomAnims] Could NOT load (blocked or bad ID): " .. entry.name)
			end
		end)
	end

	local function bump(entry)
		if entry.loaded or entry.loading or entry.bumped then return end
		entry.bumped = true
		for i, e in ipairs(loadQueue) do
			if e == entry then
				table.remove(loadQueue, i)
				break
			end
		end
		table.insert(loadQueue, 1, entry)
	end

	local function best(entry)
		if not entry or entry.disabled then return nil end
		if not entry.loaded then
			bump(entry)
			return nil
		end
		for _, t in ipairs(entry.tracks) do
			if t.Length > 0 then return t end
		end
		if os.clock() - entry.t0 < 5 then
			return entry.tracks[1]
		end
		return nil
	end

	local function usable(entry)
		return best(entry) ~= nil
	end

	local function loadList(ids, label, looped)
		local out = {}
		for i = 1, #ids do
			out[i] = loadTrack(ids[i], label .. " " .. i .. " (" .. ids[i] .. ")", looped)
		end
		return out
	end

	local walkTrack = loadTrack(WALK_ID, "Walk (" .. WALK_ID .. ")", true)
	local mediumTrack = loadTrack(MEDIUM_ID, "Medium (" .. MEDIUM_ID .. ")", true)
	local runTrack = loadTrack(RUN_ID, "Run (" .. RUN_ID .. ")", true)
	local idleTracks = loadList(IDLE_IDS, "Idle", true)
	local fallTracks = loadList(FALL_IDS, "Fall", true)
	local jumpTracks = loadList(JUMP_IDS, "Jump", false)
	local flipTrack = loadTrack(FLIP_ID, "Flip (" .. FLIP_ID .. ")", false)
	local rollTrack = loadTrack(ROLL_ID, "Roll (" .. ROLL_ID .. ")", false)
	local swingTracks = loadList(SWING_IDS, "Swing", true)
	local swingHangTrack = loadTrack(SWING_HANG_ID, "Swing Hang (" .. SWING_HANG_ID .. ")", true)
	local wallIdleTrack = loadTrack(WALL_IDLE_ID, "Wall Hang Idle (" .. WALL_IDLE_ID .. ")", true)
	local kneeTrack = loadTrack(KNEE_SLIDE_ID, "Knee Slide (" .. KNEE_SLIDE_ID .. ")", false)
	local bellyTrack = loadTrack(BELLY_SLIDE_ID, "Belly Slide (" .. BELLY_SLIDE_ID .. ")", false)
	local crouchTracks = loadList(CROUCH_IDS, "Crouch", true)
	local crawlTracks = loadList(CRAWL_IDS, "Crawl", true)
	local climbTracks = loadList(CLIMB_IDS, "Climb", true)

	do
		local slotMap = {
			idle = {list = idleTracks, defaults = IDLE_IDS, label = "Idle", looped = true},
			walk = {entry = walkTrack, default = WALK_ID},
			jog = {entry = mediumTrack, default = MEDIUM_ID},
			run = {entry = runTrack, default = RUN_ID},
			jump = {list = jumpTracks, defaults = JUMP_IDS, label = "Jump", looped = false},
			flip = {entry = flipTrack, default = FLIP_ID},
			fall = {list = fallTracks, defaults = FALL_IDS, label = "Fall", looped = true},
			roll = {entry = rollTrack, default = ROLL_ID},
			wallhang = {entry = wallIdleTrack, default = WALL_IDLE_ID},
			swing = {list = swingTracks, defaults = SWING_IDS, label = "Swing", looped = true},
			swinghang = {entry = swingHangTrack, default = SWING_HANG_ID},
			climb = {list = climbTracks, defaults = CLIMB_IDS, label = "Climb", looped = true},
			knee = {entry = kneeTrack, default = KNEE_SLIDE_ID},
			belly = {entry = bellyTrack, default = BELLY_SLIDE_ID},
			crawl = {list = crawlTracks, defaults = CRAWL_IDS, label = "Crawl", looped = true},
			crouch = {list = crouchTracks, defaults = CROUCH_IDS, label = "Crouch", looped = true},
		}
		local function stopEntry(e)
			for _, t in ipairs(e.tracks) do
				pcall(function() t:Stop(0.1) end)
			end
			e.tracks = {}
		end
		local function resetEntry(e, id, name)
			if e.id == id and not e.disabled then return end
			stopEntry(e)
			e.gen += 1
			e.id = id
			e.name = name
			e.loaded, e.loading, e.bumped, e.disabled = false, false, false, nil
			table.insert(loadQueue, 1, e)
		end
		local function applySlot(key)
			local s = slotMap[key]
			if not s then return end
			local ov = Anim.get(key)
			if s.list then
				local wanted = ov and {ov.id} or s.defaults
				for i = 1, math.max(#s.list, #wanted) do
					local e, id = s.list[i], wanted[i]
					if id then
						local nm = s.label .. " " .. i .. " (" .. id .. ")"
						if e then
							resetEntry(e, id, nm)
						else
							s.list[i] = loadTrack(id, nm, s.looped)
						end
					elseif e and not e.disabled then
						e.disabled = true
						stopEntry(e)
					end
				end
			else
				local id = ov and ov.id or s.default
				resetEntry(s.entry, id, "Anim " .. key .. " (" .. id .. ")")
			end
		end
		Anim.apply = function(key)
			if not alive then return end
			if key then
				applySlot(key)
			else
				for k in pairs(slotMap) do applySlot(k) end
			end
		end
		Anim.apply()
	end

	for _ = 1, 3 do
		task.spawn(function()
			while alive do
				local e = table.remove(loadQueue, 1)
				if e then
					ensureLoaded(e)
					task.wait(0.03)
				else
					task.wait(0.25)
				end
			end
		end)
	end

