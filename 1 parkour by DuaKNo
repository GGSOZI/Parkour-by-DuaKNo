-- ================= SAVED SETTINGS (on this device) =================
local Store = {
	file = "ParkourSettings.json",
	data = {vibration = true, idleOff = false, overrides = {}},
	canFile = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function",
}
do
	local cached = ENV.__ParkourSaved
	if Store.canFile then
		local ok, res = pcall(function()
			if isfile(Store.file) then
				return HttpService:JSONDecode(readfile(Store.file))
			end
		end)
		if ok and type(res) == "table" then cached = res end
	end
	if type(cached) == "table" then
		if type(cached.vibration) == "boolean" then Store.data.vibration = cached.vibration end
		if type(cached.idleOff) == "boolean" then Store.data.idleOff = cached.idleOff end
		if type(cached.overrides) == "table" then
			for k, v in pairs(cached.overrides) do
				if type(k) == "string" and type(v) == "table" and tonumber(v.id) then
					Store.data.overrides[k] = {id = tonumber(v.id), name = tostring(v.name or v.id)}
				end
			end
		end
	end
end
local saveQueued = false
function Store.save()
	ENV.__ParkourSaved = Store.data
	if not Store.canFile or saveQueued then return end
	saveQueued = true
	task.delay(0.4, function()
		saveQueued = false
		pcall(function()
			-- ids are written as text so 15-digit asset ids can't lose digits in JSON
			local ov = {}
			for k, v in pairs(Store.data.overrides) do
				ov[k] = {id = string.format("%.0f", v.id), name = v.name}
			end
			writefile(Store.file, HttpService:JSONEncode({
				vibration = Store.data.vibration, idleOff = Store.data.idleOff, overrides = ov,
			}))
		end)
	end)
end

